# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==============================
# Virtual Environments
# ==============================
venv/
.venv/
env/
ENV/

# ==============================
# Environment / Secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Python build / package files
# ==============================
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==============================
# Pytest / Coverage
# ==============================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover

# ==============================
# Type checking / lint caches
# ==============================
.mypy_cache/
.pyright/
.ruff_cache/

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# IDE / Editor
# ==============================
.vscode/
.idea/
*.code-workspace

# ==============================
# OS files
# ==============================
.DS_Store
Thumbs.db
desktop.ini

# ==============================
# Logs
# ==============================
*.log
logs/
log/

# ==============================
# Temporary / Scratch files
# ==============================
tmp/
temp/
scratch/
*.tmp
*.temp
*.bak
*.swp
*.swo

# ==============================
# Streamlit
# ==============================
.streamlit/secrets.toml

# Keep Streamlit config if you have one
!.streamlit/config.toml

# ==============================
# Local model/download caches
# ==============================
.cache/
huggingface/
transformers_cache/

# ==============================
# Generated / large model artifacts
# ==============================
artifacts/models/*.joblib
artifacts/models/*.pkl
artifacts/models/*.pt
artifacts/models/*.pth
artifacts/models/*.bin

# ==============================
# Generated analytics artifacts
# ==============================
artifacts/analytics/*.json
artifacts/demo/*.json
artifacts/reports/*.json
artifacts/figures/

# Keep folders in Git if needed
!artifacts/analytics/.gitkeep
!artifacts/demo/.gitkeep
!artifacts/reports/.gitkeep
!artifacts/figures/.gitkeep
!artifacts/models/.gitkeep


# Keep demo input data if you want it versioned
!data/demo/
!data/demo/demo_reports.json

# ==============================
# SQLite
# ==============================
*.sqlite
*.sqlite3
*.db

# ==============================
# Uploaded / user-generated files
# ==============================
uploads/
uploaded_files/

# ==============================
# FastAPI / Uvicorn runtime
# ==============================
*.pid

# ==============================
# PowerShell / local scripts output
# ==============================
*.ps1.log

# ==============================
# Model checkpoints / training outputs
# ==============================
checkpoints/
runs/
wandb/

# ==============================
# Local configuration
# ==============================
config.local.*
settings.local.*

# ==============================
# Misc
# ==============================
*.zip
*.tar
*.tar.gz